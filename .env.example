# Optional shell environment variables. This file is documentation, not auto-loaded.
# Always bind to loopback in this experimental build.
PORT=8765
# HD_DATA_DIR=/absolute/private/directory

# Optional ASR adapter. Disabled when unset; only loopback HTTP endpoints allowed.
# HD_ASR_URL=http://127.0.0.1:8766/transcribe

# Optional cloud AI. Disabled unless explicitly set to 1. No keys are included.
# HD_ENABLE_CLOUD_AI=1
# HD_CLOUD_ASR_PROVIDER=openai
# HD_CLOUD_ASR_MODEL=your-audio-model-id
# HD_LLM_PROVIDER=deepseek
# HD_LLM_MODEL=your-json-chat-model-id
# OPENAI_API_KEY=obtain-and-store-privately
# DEEPSEEK_API_KEY=obtain-and-store-privately
# ARK_API_KEY=obtain-and-store-privately
# DASHSCOPE_API_KEY=obtain-and-store-privately
# HD_QWEN_REGION=cn
# If a local ASR adapter forwards to a cloud service, disclose its destination:
# HD_ASR_EXTERNAL=1
# HD_ASR_LABEL=Actual provider and region
# HD_ASR_TOKEN=private-adapter-token
# See docs/MODEL_INTEGRATION.md. No model names are assumed permanently valid.
